{
  // Keep & Flip Worker source-control TEST, not a production deployment.
  // The existing Worker is named late-smoke-2a21 on Cloudflare.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "late-smoke-2a21",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  // Keep any production non-secret variables already set in the dashboard.
  // Secrets stay in Cloudflare and must NEVER be stored in this repository.
  "keep_vars": true,
  // Previews are isolated and DO NOT inherit production variables or secrets.
  "previews": {
    "vars": {
      // GitHub Pages browser origin (not the repository pathname).
      "APP_ORIGIN": "https://gregncheese.github.io",
      // Live product discovery without paid Google Search or additional API keys.
      "ENABLE_GOOGLE_SEARCH": "false",
      "DIRECT_WEB_DISCOVERY": "true",
      "KEEPFLIP_REGISTRY_URL": "https://raw.githubusercontent.com/GregNcheese/keepflip-cardmarket-sync/refs/heads/test/cloudflare-worker-autofill-216-fresh-preview/worker/data/verified-products-starter.json"
    }
  }
}
